# Copy this file to .env and fill in your values

# MongoDB connection (same as server/.env)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/clinictrust

# MLflow tracking server
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_RISK=clinictrust-risk-scoring
MLFLOW_EXPERIMENT_REFERRAL=clinictrust-referral-outcome
MLFLOW_EXPERIMENT_ALERT=clinictrust-alert-classifier

# Express API (for agent tools)
API_BASE_URL=http://localhost:5000
ADMIN_TOKEN=your_admin_jwt_token_here

# Azure OpenAI (for RAG & agents)
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your_azure_openai_key
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-ada-002
AZURE_OPENAI_API_VERSION=2024-02-15-preview
